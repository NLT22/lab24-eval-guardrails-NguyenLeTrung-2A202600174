# cp .env.example .env

# Cloud provider keys. OPENAI_API_KEY is optional when LM Studio is running.
OPENAI_API_KEY=
COHERE_API_KEY=

# HuggingFace token for gated models such as Llama Guard 3.
# Create at https://huggingface.co/settings/tokens and accept the model license.
HF_TOKEN=
HUGGINGFACEHUB_API_TOKEN=

# LangSmith tracing for eval/judge runs.
# Create key at https://smith.langchain.com/ and set LANGSMITH_TRACING=true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lab24-eval-guardrails
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Provider selection:
# - auto: OpenAI when key exists, otherwise LM Studio local.
# - openai: force OpenAI.
# - lmstudio: force LM Studio OpenAI-compatible server.
# - sentence_transformers: embedding provider only, local Python model fallback.
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto

# LM Studio local server. Start "Local Server" in LM Studio first.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-chat-model
LMSTUDIO_EMBEDDING_MODEL=local-embedding-model
LMSTUDIO_GUARD_MODEL=local-llama-guard-model
LMSTUDIO_CHAT_TIMEOUT=120
LMSTUDIO_EMBEDDING_TIMEOUT=60

# Output safety guard:
# - auto: try HuggingFace Llama Guard, then LM Studio guard model, then fallback.
# - hf: force HuggingFace Transformers.
# - lmstudio: force LM Studio OpenAI-compatible Llama Guard.
# - rule_based: deterministic local fallback for smoke tests.
OUTPUT_GUARD_PROVIDER=auto
LLAMA_GUARD_MODEL=meta-llama/Llama-Guard-3-8B
